# Cloudflare WorkerのWORKER_TOKENと同じ値を、RenderのSecretとして設定します。
YT_AUDIO_WORKER_TOKEN=replace-with-your-worker-token
YT_AUDIO_WORKER_URL=https://yt-audio-regional-resolver.youtube-audio-stream-probe.workers.dev/audio

# Render Free（512 MB）向けの安全な上限。
MAX_CONTENT_MB=80
MAX_MEDIA_DURATION_SECONDS=240
MEDIA_TTL_SECONDS=1800
MAX_QUEUED_JOBS=3
RATE_LIMIT_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=3600
GLOBAL_RATE_LIMIT_REQUESTS=20
MAX_JSON_BODY_BYTES=16384

# 別オリジンでUIを配信するときだけ、その完全なオリジンをカンマ区切りで追加します。
FRONTEND_ORIGINS=http://127.0.0.1:4173,http://localhost:4173

# 任意。未設定なら起動ごとに安全なランダム鍵を生成します。
MEDIA_SIGNING_KEY=replace-with-a-long-random-secret
